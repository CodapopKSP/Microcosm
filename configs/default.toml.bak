# Evolution Sim — default configuration (Phase 1+)
# Loaded at startup from configs/default.toml (see README).

[world]
width = 900.0
height = 700.0
boundary = "bounce"
initial_population = 80
default_agent_radius = 12.0
# Initial velocity magnitude at spawn (clamped each tick to phenotype max_speed).
min_speed = 5.0
max_speed = 50.0

[performance]
max_entities = 5000
failsafe_policy = "stop_spawns"

[genetics]
genome_version = 1
core_length = 32
# Header EVO1 + default ancestor core (see docs/GENOME.md)
# max_speed locus (core 24–25) = 0x0000 → speed_min (0); offspring can mutate faster.
ancestor_hex = "45564f3188cc4480400030002800800040003000808000008000000000000000"
# More passes / higher p_point, but point_noise is nibble ±1 (one hex digit per byte).
p_bit_flip = 0.05
p_point = 0.55
p_resample = 0.02
p_dup = 0.0
p_del = 0.0
mutations_per_offspring = 4
delta_max = 1
# Initial worldgen uses ancestor_hex as-is (no mutation); offspring mutate on reproduce (Phase 1H).

[genetics.decode_ranges]
body_radius_min = 6.0
body_radius_max = 20.0
photo_max = 1.0
k_photo = 0.15
meta_min = 0.05
meta_max = 2.0
loco_max = 1.0
speed_min = 0.0
speed_max = 50.0
e_min = 15.0
e_max = 80.0
cd_min = 120.0
cd_max = 2400.0
k_armor = 0.08
k_move_hardness = 0.02
chemo_cliff = 0.35
# Locomotion → move_cost; max_speed locus (core bytes 24–25) → speed_min..speed_max.
# v_base / k_v kept for config compatibility; speed uses speed_min / speed_max.
v_base = 15.0
k_v = 90.0
m_base = 0.01
k_m = 0.06
k_drag = 0.004
r_ref = 12.0
k_move_meta = 0.1

[economy]
metabolism_floor = 0.1
spawn_energy = 50.0
flat_energy_grant_per_tick = 0.0
core_max_hp = 100.0
repro_safety_margin = 0.25
p_death_on_repro_base = 0.15
repair_energy_per_hp = 1.0

# Phase 2E: Model A local irradiance (flat grant unused; legacy_flat for Phase 1 regression).
[environment]
energy_model = "local"
solar_constant = 3.8
light_mode = "gradient_y"
gradient_axis = "y"
gradient_min = 0.15
gradient_max = 1.0
gradient_bright_at = "top"
crowding_blocks_photosynthesis = false

[run]
master_seed = 42
max_ticks = 360000
snapshot_interval = 60
metrics_path = "metrics.jsonl"
